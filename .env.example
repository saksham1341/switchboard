# GitHub webhook HMAC secret (Settings → Webhooks → Secret)
GITHUB_WEBHOOK_SECRET=replace-me

# Cloudflare Tunnel — ONLY needed if you run the bundled tunnel container
# (`docker compose --profile tunnel up -d`). Leave empty when cloudflared
# already runs as a host service; that daemon holds its own credentials.
#
# Public Hostname origin depends on which one you use:
#   host cloudflared  -> http://localhost:8080
#   bundled tunnel    -> http://switchboard:8080
TUNNEL_TOKEN=

# Host loopback port the app is published on (what host cloudflared points at).
SB_HOST_PORT=8080

# --- Discord (optional) -------------------------------------------------
# Leave DISCORD_BOT_TOKEN empty to run GitHub-only: no bot, no slash commands,
# no relay into Discord. If it IS set, DISCORD_APPLICATION_ID is required and
# the app fails fast at startup without it.
#
# Bot needs the `bot` + `applications.commands` scopes, and Send Messages in the
# target channel (channel posts require it; interaction replies do not).
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Guild id makes slash commands register instantly; unset syncs globally (~1h).
DISCORD_GUILD_ID=
# Channel the github-notify decider posts GitHub events into.
# Unset = slash commands work, but GitHub events are not relayed.
DISCORD_GITHUB_NOTIFY_CHANNEL_ID=

# --- Optional tuning ----------------------------------------------------
SB_MAX_LOG_MESSAGES=10000
SB_PORT=8080
