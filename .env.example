# GitHub webhook HMAC secret (Settings → Webhooks → Secret)
GITHUB_WEBHOOK_SECRET=replace-me

# Host loopback port the app is published on. Whatever ingress you run on the
# host (cloudflared, nginx, caddy) points at http://localhost:<this>.
SB_HOST_PORT=8080

# --- Discord (optional) -------------------------------------------------
# Leave DISCORD_BOT_TOKEN empty to run GitHub-only: no bot, no slash commands,
# no relay into Discord. If it IS set, DISCORD_APPLICATION_ID is required and
# the app fails fast at startup without it.
#
# Scopes: `bot` + `applications.commands`.
#
# Permissions (integer 274877991936; use 309237730304 to also allow the bot to
# create public threads):
#   View Channel              seeing anything at all
#   Send Messages             replies and the GitHub relay
#   Send Messages in Threads  posting into a conversation's thread
#   Embed Links               the GitHub relay's embeds and link buttons
#   Read Message History      discord.history; 403s without it
#
# Channel-level overrides beat all of these. If the bot is in the guild but one
# channel returns "Missing Access", check that channel's permission overrides
# before suspecting the invite.
#
# The bot ALWAYS listens for messages, so the privileged MESSAGE CONTENT intent
# must be enabled in the Developer Portal (Applications -> Bot -> Privileged
# Gateway Intents). Without it the gateway refuses login and the sensor dies at
# startup. That is deliberate: the alternative is a bot that connects fine and
# silently never responds, which is far harder to diagnose.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Guild id makes slash commands register instantly; unset syncs globally (~1h).
DISCORD_GUILD_ID=
# Channel the github-notify decider posts GitHub events into.
# Unset = slash commands work, but GitHub events are not relayed.
DISCORD_GITHUB_NOTIFY_CHANNEL_ID=

# --- Agent (optional) ---------------------------------------------------
# The agentic decider is wired only when SB_LLM_API_KEY *and* Discord are both
# set. A key without Discord would hand the agent a tool list naming actuators
# nobody bound, and an unconsumed command does not fail -- it simply hangs, with
# no error to observe.
#
# SB_LLM_BACKEND picks the provider:
#   anthropic   native Messages API; needs only the key
#   openai      any OpenAI-compatible endpoint; also needs SB_LLM_BASE_URL.
#               Covers Groq, Gemini, Cerebras, OpenRouter, GitHub Models, Ollama.
#
# The key is deliberately NOT provider-named: switching backends should be a
# config change, not an env-var rename.
#
# SB_LLM_MODEL is required and is sent on every request. Nothing defaults it --
# the command recorded in the log is the record of what actually ran, and a
# silent backend default would make old commands unreplayable the moment that
# default changed.
#
#   Groq     https://api.groq.com/openai/v1                          llama-3.3-70b-versatile
#   Gemini   https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama   http://localhost:11434/v1
SB_LLM_BACKEND=anthropic
SB_LLM_API_KEY=
SB_LLM_BASE_URL=
SB_LLM_MODEL=

# --- Dashboard (optional) -----------------------------------------------
# Set a token to enable the live dashboard; unset = no dashboard at all. It
# fails closed rather than serving an unauthenticated ingest endpoint, so there
# is deliberately no default.
#
# It serves on the main port, so public ingress reaches it. The page is
# structure-only -- names, ids, causal links, never payloads or tokens -- which
# is what makes public exposure acceptable.
SB_DASHBOARD_TOKEN=

# --- Optional tuning ----------------------------------------------------
# How many times a message is retried before it dead-letters.
SB_MESSAGE_MAX_RETRIES=10
# How long a handler gets per attempt before the Bus times it out.
SB_HANDLER_TIMEOUT_S=100
# Ceiling on the Bus's own jittered exponential backoff between retries.
SB_RETRY_BACKOFF_MAX_S=300
# Ceiling the Bus clamps a handler-requested retry_after to (e.g. a 429's delay).
SB_RETRY_AFTER_MAX_S=120
# Long-poll wait per acquire_blocking call on the consume loop.
SB_CONSUMER_WAIT_MS=30000
# How often the lease reaper sweeps for expired leases.
SB_LEASE_REAPER_INTERVAL_S=60
# How long a processed (group, msg.id) pair is remembered for dedup.
SB_DEDUP_TTL_S=3600
# Ring-buffer size of the event log before old messages are evicted.
SB_LOG_MAX_MESSAGES=100000
# How many dead-lettered messages are kept before the oldest are dropped.
SB_LOG_MAX_DEAD=500
SB_PORT=8080
